# ==============================================================================
# Blast Crackers - Production Environment Variables Template
# Copy this file to .env and fill in your actual values before deploying.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Database Connection (Cloud PostgreSQL: Supabase / Render / Neon)
# If left unset, local development will fallback to embedded SQLite (data/database.sqlite)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Security & Authentication
# Generate a strong 32+ character string (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_string_minimum_32_characters

# CORS & Cross-Origin Configuration
# Set to your frontend deployment URL (e.g. Vercel, Netlify, or custom domain)
FRONTEND_URL=https://blast-crackers.vercel.app
CORS_ORIGIN=https://blast-crackers.vercel.app

# UPI QR Payment Gateway Configuration
SHOP_UPI_ID=YOUR_UPI_ID@upi
SHOP_NAME="Blast Crackers Sivakasi"
REQUIRE_UTR=true
PAYMENT_EXPIRY_MINUTES=15

# Cloud Image Storage Option 1: Cloudinary (Recommended for image optimization)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloud Image Storage Option 2: Supabase Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=blast_crackers
